# Set server-only environment variables in Vercel; never commit real secrets.
DATABASE_URL=postgresql://USER:SECRET@HOST/neondb?sslmode=require
NEON_AUTH_BASE_URL=https://ep-xxxx.neonauth.../neondb/auth
NEON_AUTH_COOKIE_SECRET=use-at-least-32-random-characters
# Only these email accounts may administer investment outreach data.
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_BASE_URL=http://localhost:3000
